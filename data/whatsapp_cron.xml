<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_delete_disappearing_messages" model="ir.cron">
            <field name="name">WhatsApp: Delete Disappearing Messages</field>
            <field name="model_id" ref="model_discuss_channel"/>
            <field name="state">code</field>
            <field name="code">model._cron_delete_disappearing_messages()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_send_scheduled_messages" model="ir.cron">
            <field name="name">WhatsApp: Send Scheduled Messages</field>
            <field name="model_id" ref="model_whatsapp_scheduled_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_scheduled_messages()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_send_group_auto_messages" model="ir.cron">
            <field name="name">WhatsApp: Auto Group Message Dispatcher</field>
            <field name="model_id" ref="model_whatsapp_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_group_auto_messages()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
