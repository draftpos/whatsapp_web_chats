<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_whatsapp_web_chats" model="ir.module.category">
            <field name="name">WhatsApp Web Chats</field>
            <field name="description">Helps you manage WhatsApp web chat access levels.</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_whatsapp_agent" model="res.groups">
            <field name="name">Agent (Own Chats Only)</field>
            <field name="category_id" ref="module_category_whatsapp_web_chats"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_whatsapp_superadmin" model="res.groups">
            <field name="name">Super Administrator (All Chats)</field>
            <field name="category_id" ref="module_category_whatsapp_web_chats"/>
            <field name="implied_ids" eval="[(4, ref('group_whatsapp_agent'))]"/>
        </record>
    </data>
</odoo>
