<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Super Admin is controlled by the res.users.is_whatsapp_super_admin checkbox
             (Odoo 19 removed res.groups.category_id, so no custom groups here). -->

        <!-- Make all internal users have CRM access by default -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>
    </data>
</odoo>
