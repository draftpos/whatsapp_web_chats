<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_quick_reply_view_tree" model="ir.ui.view">
        <field name="name">whatsapp.quick.reply.tree</field>
        <field name="model">whatsapp.quick.reply</field>
        <field name="arch" type="xml">
            <list string="Quick Replies">
                <field name="shortcut"/>
                <field name="body"/>
                <field name="account_id"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_quick_reply_view_form" model="ir.ui.view">
        <field name="name">whatsapp.quick.reply.form</field>
        <field name="model">whatsapp.quick.reply</field>
        <field name="arch" type="xml">
            <form string="Quick Reply">
                <sheet>
                    <group>
                        <field name="shortcut"/>
                        <field name="account_id"/>
                    </group>
                    <group>
                        <field name="body"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_quick_reply_action" model="ir.actions.act_window">
        <field name="name">Quick Replies</field>
        <field name="res_model">whatsapp.quick.reply</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
