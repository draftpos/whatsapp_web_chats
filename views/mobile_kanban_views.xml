<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- whatsapp.message -->
    <record id="whatsapp_message_view_kanban" model="ir.ui.view">
        <field name="name">whatsapp.message.kanban</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="mobile_number"/>
                <field name="create_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-8">
                                    <strong><field name="mobile_number"/></strong>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="badge rounded-pill text-bg-info"><field name="state"/></span>
                                </div>
                            </div>
                            <div class="row text-muted mt-2">
                                <div class="col-12">
                                    <field name="create_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="whatsapp.whatsapp_message_action" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form</field>
    </record>

