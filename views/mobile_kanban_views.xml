<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- whatsapp.message -->
    <record id="whatsapp_message_view_kanban" model="ir.ui.view">
        <field name="name">whatsapp.message.kanban</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="mobile_number"/>
                <field name="create_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click" style="padding: 16px; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 12px; background: white; border: 1px solid #f0f2f5;">
                            <div class="row m-0 m-0" style="margin-bottom: 8px;">
                                <div class="col-8">
                                    <strong style="font-size: 16px; color: #111b21;"><field name="mobile_number"/></strong>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="badge rounded-pill" style="background-color: #008069; color: white; padding: 4px 8px;"><field name="state"/></span>
                                </div>
                            </div>
                            <div class="row m-0 text-muted mt-2">
                                <div class="col-12" style="font-size: 12px; color: #8696a0;">
                                    <i class="fa fa-clock-o me-1" title="Time"/><field name="create_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="whatsapp.whatsapp_message_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Messages</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- whatsapp.account -->
    <record id="whatsapp_account_view_kanban" model="ir.ui.view">
        <field name="name">whatsapp.account.kanban</field>
        <field name="model">whatsapp.account</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="phone_number"/>
                <field name="account_uid"/>
                <field name="active"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click" style="padding: 16px; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 12px; background: white; border: 1px solid #f0f2f5;">
                            <div class="row m-0" style="margin-bottom: 6px;">
                                <div class="col-8">
                                    <strong style="font-size: 16px; color: #111b21;"><field name="name"/></strong>
                                </div>
                                <div class="col-4 text-end">
                                    <span t-if="record.active.raw_value" class="badge rounded-pill" style="background-color: #25D366; color: white; padding: 4px 8px;">Active</span>
                                    <span t-else="" class="badge rounded-pill" style="background-color: #8696a0; color: white; padding: 4px 8px;">Inactive</span>
                                </div>
                            </div>
                            <div class="row m-0 mt-1" t-if="record.phone_number.value">
                                <div class="col-12" style="font-size: 13px; color: #54656f;">
                                    <i class="fa fa-phone me-1" title="Phone"/><field name="phone_number"/>
                                </div>
                            </div>
                            <div class="row m-0 mt-1" t-if="record.account_uid.value">
                                <div class="col-12" style="font-size: 12px; color: #8696a0;">
                                    <i class="fa fa-id-card me-1" title="Account ID"/>Account ID: <field name="account_uid"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="whatsapp.whatsapp_account_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Business Account</field>
        <field name="res_model">whatsapp.account</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new WhatsApp Business Account
            </p>
        </field>
    </record>

    <!-- wa.chatbot.flow -->
    <record id="wa_chatbot_flow_view_kanban" model="ir.ui.view">
        <field name="name">wa.chatbot.flow.kanban</field>
        <field name="model">wa.chatbot.flow</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="chatbot_id"/>
                <field name="state"/>
                <field name="description"/>
                <field name="node_count"/>
                <field name="is_default"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click" style="padding: 16px; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 12px; background: white; border: 1px solid #f0f2f5;">
                            <div class="row m-0" style="margin-bottom: 6px;">
                                <div class="col-8">
                                    <strong style="font-size: 16px; color: #111b21;"><field name="name"/></strong>
                                    <span t-if="record.is_default.raw_value" style="margin-left: 6px; font-size: 10px; background: #e8f5e9; color: #25D366; border-radius: 4px; padding: 2px 5px;">Default</span>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="badge rounded-pill" t-att-style="'background-color:' + (record.state.raw_value === 'active' ? '#25D366' : '#8696a0') + '; color:white; padding:4px 8px;'"><field name="state"/></span>
                                </div>
                            </div>
                            <div class="row m-0 mt-1">
                                <div class="col-12" style="font-size: 13px; color: #54656f;">
                                    <i class="fa fa-android me-1" title="Chatbot"/><field name="chatbot_id"/>
                                </div>
                            </div>
                            <div class="row m-0 mt-1" t-if="record.description.value">
                                <div class="col-12" style="font-size: 12px; color: #8696a0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <field name="description"/>
                                </div>
                            </div>
                            <div class="row m-0 mt-1">
                                <div class="col-12" style="font-size: 12px; color: #8696a0;">
                                    <i class="fa fa-sitemap me-1" title="Nodes"/><field name="node_count"/> nodes
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="dev_whatsapp_chatbot_ent.action_wa_chatbot_flow" model="ir.actions.act_window">
        <field name="name">Chatbot Flow</field>
        <field name="res_model">wa.chatbot.flow</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- wa.chatbot.session -->
    <record id="wa_chatbot_session_view_kanban" model="ir.ui.view">
        <field name="name">wa.chatbot.session.kanban</field>
        <field name="model">wa.chatbot.session</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="display_name"/>
                <field name="state"/>
                <field name="chatbot_id"/>
                <field name="phone"/>
                <field name="started_at"/>
                <field name="message_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click" style="padding: 16px; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 12px; background: white; border: 1px solid #f0f2f5;">
                            <div class="row m-0" style="margin-bottom: 6px;">
                                <div class="col-8">
                                    <strong style="font-size: 16px; color: #111b21;"><field name="display_name"/></strong>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="badge rounded-pill" style="background-color: #008069; color: white; padding: 4px 8px;"><field name="state"/></span>
                                </div>
                            </div>
                            <div class="row m-0 mt-1">
                                <div class="col-12" style="font-size: 13px; color: #54656f;">
                                    <i class="fa fa-android me-1" title="Chatbot"/><field name="chatbot_id"/>
                                </div>
                            </div>
                            <div class="row m-0 mt-1" t-if="record.phone.value">
                                <div class="col-12" style="font-size: 13px; color: #54656f;">
                                    <i class="fa fa-phone me-1" title="Phone"/><field name="phone"/>
                                </div>
                            </div>
                            <div class="row m-0 mt-1">
                                <div class="col-6" style="font-size: 12px; color: #8696a0;">
                                    <i class="fa fa-comments me-1" title="Messages"/><field name="message_count"/> msgs
                                </div>
                                <div class="col-6 text-end" style="font-size: 12px; color: #8696a0;">
                                    <i class="fa fa-clock-o me-1" title="Time"/><field name="started_at"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="dev_whatsapp_chatbot_ent.action_wa_chatbot_session" model="ir.actions.act_window">
        <field name="name">Chatbot Sessions</field>
        <field name="res_model">wa.chatbot.session</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- wa.chatbot.keyword -->
    <record id="wa_chatbot_keyword_view_kanban" model="ir.ui.view">
        <field name="name">wa.chatbot.keyword.kanban</field>
        <field name="model">wa.chatbot.keyword</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="chatbot_id"/>
                <field name="keyword"/>
                <field name="match_type"/>
                <field name="active"/>
                <field name="target_flow_id"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click" style="padding: 16px; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 12px; background: white; border: 1px solid #f0f2f5;">
                            <div class="row m-0" style="margin-bottom: 6px;">
                                <div class="col-8">
                                    <strong style="font-size: 16px; color: #111b21;"><field name="keyword"/></strong>
                                </div>
                                <div class="col-4 text-end">
                                    <span t-if="record.active.raw_value" class="badge rounded-pill" style="background-color: #25D366; color: white; padding: 4px 8px;">Active</span>
                                    <span t-else="" class="badge rounded-pill" style="background-color: #8696a0; color: white; padding: 4px 8px;">Inactive</span>
                                </div>
                            </div>
                            <div class="row m-0 mt-1" t-if="record.name.value">
                                <div class="col-12" style="font-size: 13px; color: #111b21;">
                                    <field name="name"/>
                                </div>
                            </div>
                            <div class="row m-0 mt-1">
                                <div class="col-12" style="font-size: 13px; color: #54656f;">
                                    <i class="fa fa-android me-1" title="Chatbot"/><field name="chatbot_id"/>
                                </div>
                            </div>
                            <div class="row m-0 mt-1">
                                <div class="col-6" style="font-size: 12px; color: #8696a0;">
                                    <i class="fa fa-tag me-1" title="Match Type"/><field name="match_type"/>
                                </div>
                                <div class="col-6 text-end" style="font-size: 12px; color: #8696a0;" t-if="record.target_flow_id.value">
                                    <i class="fa fa-arrow-right me-1" title="Target Flow"/><field name="target_flow_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="dev_whatsapp_chatbot_ent.action_wa_chatbot_keyword" model="ir.actions.act_window">
        <field name="name">Chatbot Keywords</field>
        <field name="res_model">wa.chatbot.keyword</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
    <!-- whatsapp.quick.reply -->
    <record id="whatsapp_quick_reply_view_kanban" model="ir.ui.view">
        <field name="name">whatsapp.quick.reply.kanban</field>
        <field name="model">whatsapp.quick.reply</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="shortcut"/>
                <field name="body"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click" style="padding: 16px; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 12px; background: white; border: 1px solid #f0f2f5;">
                            <div class="row m-0 m-0">
                                <div class="col-12">
                                    <strong style="font-size: 16px; color: #111b21; display: block; margin-bottom: 8px;"><field name="shortcut"/></strong>
                                </div>
                            </div>
                            <div class="row m-0 mt-2">
                                <div class="col-12" style="font-size: 14px; color: #54656f; line-height: 1.4; white-space: pre-wrap; word-wrap: break-word;">
                                    <field name="body"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="whatsapp_web_chats.whatsapp_quick_reply_config_action" model="ir.actions.act_window">
        <field name="name">Quick Replies</field>
        <field name="res_model">whatsapp.quick.reply</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
    <record id="whatsapp.whatsapp_template_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Template</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="whatsapp_template_view_kanban" model="ir.ui.view">
        <field name="name">whatsapp.template.kanban</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="status"/>
                <field name="lang_code"/>
                <field name="template_type"/>
                <field name="body"/>
                <field name="wa_account_id"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click" style="padding: 16px; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 12px; background: white; border: 1px solid #f0f2f5;">
                            <div class="row m-0" style="margin-bottom: 6px;">
                                <div class="col-8">
                                    <strong style="font-size: 16px; color: #111b21;"><field name="name"/></strong>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="badge rounded-pill" style="background-color: #008069; color: white; padding: 4px 8px;"><field name="status"/></span>
                                </div>
                            </div>
                            <div class="row m-0 mt-1" t-if="record.body.value">
                                <div class="col-12" style="font-size: 13px; color: #54656f; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <field name="body"/>
                                </div>
                            </div>
                            <div class="row m-0 mt-1">
                                <div class="col-6" style="font-size: 12px; color: #8696a0;">
                                    <i class="fa fa-language me-1" title="Language"/><field name="lang_code"/>
                                </div>
                                <div class="col-6 text-end" style="font-size: 12px; color: #8696a0;">
                                    <i class="fa fa-tag me-1" title="Type"/><field name="template_type"/>
                                </div>
                            </div>
                            <div class="row m-0 mt-1" t-if="record.wa_account_id.value">
                                <div class="col-12" style="font-size: 12px; color: #8696a0;">
                                    <i class="fa fa-whatsapp me-1" title="WhatsApp"/><field name="wa_account_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
