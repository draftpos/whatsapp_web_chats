<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_account_form_inherit" model="ir.ui.view">
        <field name="name">whatsapp.account.form.inherit.chats</field>
        <field name="model">whatsapp.account</field>
        <field name="inherit_id" ref="whatsapp.whatsapp_account_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="before">
                <field name="image_1920" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
            </xpath>
            <xpath expr="//div[@id='tocontrol']" position="after">
                <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small">Chatbot &amp; Routing</div>
                <div class="row mt16 o_settings_container" id="chatbot_control">
                    <setting>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </setting>
                    <setting>
                        <field name="tenant_id"/>
                        <div class="text-muted mt-1" style="font-size:12px;">
                            Chats and data for this account will be scoped to this tenant.
                        </div>
                    </setting>
                    <setting>
                        <field name="wa_bot_active"/>
                    </setting>
                    <setting>
                        <field name="wa_department_routing_active"/>
                    </setting>
                </div>
                
                <notebook>
                    <page string="Auto Follow-ups" name="auto_follow_ups">
                        <field name="followup_rule_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="delay_condition"/>
                                <field name="delay_value" invisible="delay_condition in ('23_hours', '24_hours')"/>
                                <field name="template_id"/>
                            </list>
                        </field>
                    </page>
                    <page string="Auto Message Share" name="auto_message_share">
                        <group>
                            <field name="wa_group_auto_message_share"/>
                            <field name="wa_group_auto_message_text" invisible="not wa_group_auto_message_share"/>
                            <field name="wa_group_auto_message_link" invisible="not wa_group_auto_message_share"/>
                        </group>
                        <div invisible="not wa_group_auto_message_share" class="mt-3 mb-3">
                            <button name="action_send_group_auto_message_to_all" 
                                    type="object" 
                                    string="Send Group Invite to All Pending Contacts in Database" 
                                    class="btn btn-primary"
                                    confirm="Are you sure you want to send the group auto message to all contacts in the database who have not received it yet?"/>
                        </div>
                    <page string="School Integration" name="school_integration">
                        <group>
                            <field name="allow_school_balances"/>
                            <field name="school_integration_type" invisible="not allow_school_balances"/>
                            <field name="school_app_url" invisible="not allow_school_balances or school_integration_type != 'remote'"/>
                            <field name="school_db_name" invisible="not allow_school_balances or school_integration_type != 'remote'"/>
                            <field name="school_username" invisible="not allow_school_balances or school_integration_type != 'remote'"/>
                            <field name="school_password" password="True" invisible="not allow_school_balances or school_integration_type != 'remote'"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="action" name="%(action_whatsapp_school_balance_log)d" icon="fa-history" invisible="not allow_school_balances">
                    <div class="o_stat_info">
                        <span class="o_stat_text">School Logs</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
