<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_whatsapp_web_chats" model="ir.actions.client">
        <field name="name">WhatsApp Web Chats</field>
        <field name="tag">whatsapp_web_chats.chats_client_action</field>
    </record>

    <!-- We don't need a root menu anymore since it's under WhatsApp -->
    <!-- Main Chats Menu - set sequence to 0 so it appears first -->
    <menuitem id="menu_whatsapp_web_chats_action" name="Chats" parent="whatsapp.whatsapp_menu_main" action="action_whatsapp_web_chats" sequence="0"/>

    <!-- Move Messages to Configuration -->
    <menuitem id="whatsapp.whatsapp_message_menu" name="Messages" parent="whatsapp.whatsapp_configuration_menu" sequence="10"/>
    
    <record id="whatsapp_quick_reply_view_form" model="ir.ui.view">
        <field name="name">whatsapp.quick.reply.view.form</field>
        <field name="model">whatsapp.quick.reply</field>
        <field name="arch" type="xml">
            <form string="Quick Reply">
                <sheet>
                    <group>
                        <field name="shortcut"/>
                        <field name="body"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                        <field name="account_id"/>
                        <field name="sequence"/>
                        <field name="is_pinned"/>
                        <field name="is_favorite"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quick Replies under Configuration -->
    <record id="whatsapp_quick_reply_config_action" model="ir.actions.act_window">
        <field name="name">Quick Replies</field>
        <field name="res_model">whatsapp.quick.reply</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_whatsapp_quick_reply" name="Quick Replies" parent="whatsapp.whatsapp_configuration_menu" action="whatsapp_quick_reply_config_action" sequence="20"/>

    <!-- Move Templates to Configuration -->
    <menuitem id="whatsapp.whatsapp_template_menu" name="Templates" parent="whatsapp.whatsapp_configuration_menu" sequence="30"/>

</odoo>
