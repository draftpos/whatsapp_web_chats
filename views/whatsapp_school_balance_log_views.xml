<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_school_balance_log_list" model="ir.ui.view">
        <field name="name">whatsapp.school.balance.log.list</field>
        <field name="model">whatsapp.school.balance.log</field>
        <field name="arch" type="xml">
            <list string="School Balance Logs" decoration-danger="status == 'failed'" decoration-success="status == 'sent'">
                <field name="create_date" string="Date" optional="show"/>
                <field name="whatsapp_account_id" optional="show"/>
                <field name="student_name" optional="show"/>
                <field name="parent_name" optional="show"/>
                <field name="parent_number" optional="show"/>
                <field name="balance_amount" widget="monetary" optional="show"/>
                <field name="trigger_type" optional="show"/>
                <field name="status" widget="badge" decoration-danger="status == 'failed'" decoration-success="status == 'sent'" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_school_balance_log_form" model="ir.ui.view">
        <field name="name">whatsapp.school.balance.log.form</field>
        <field name="model">whatsapp.school.balance.log</field>
        <field name="arch" type="xml">
            <form string="School Balance Log">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="whatsapp_account_id"/>
                            <field name="student_name"/>
                            <field name="parent_name"/>
                            <field name="parent_number"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="balance_amount" widget="monetary"/>
                            <field name="trigger_type"/>
                            <field name="move_id_ref"/>
                        </group>
                    </group>
                    <group string="Error Details" invisible="status != 'failed'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_school_balance_log_search" model="ir.ui.view">
        <field name="name">whatsapp.school.balance.log.search</field>
        <field name="model">whatsapp.school.balance.log</field>
        <field name="arch" type="xml">
            <search string="Search Logs">
                <field name="student_name"/>
                <field name="parent_name"/>
                <field name="parent_number"/>
                <field name="whatsapp_account_id"/>
                <filter string="Sent Successfully" name="sent" domain="[('status', '=', 'sent')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter string="Manual Trigger" name="manual" domain="[('trigger_type', '=', 'manual')]"/>
                <filter string="Billing Trigger" name="billing" domain="[('trigger_type', '=', 'billing')]"/>
                <filter string="Student Statement" name="statement" domain="[('trigger_type', '=', 'statement')]"/>
                <filter string="Scheduled Sync" name="cron" domain="[('trigger_type', '=', 'cron')]"/>
                <separator/>
                <filter string="Status" name="group_by_status" context="{'group_by':'status'}"/>
                <filter string="Trigger Type" name="group_by_trigger" context="{'group_by':'trigger_type'}"/>
                <filter string="Date" name="group_by_date" context="{'group_by':'create_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_school_balance_log" model="ir.actions.act_window">
        <field name="name">School Balance Logs</field>
        <field name="res_model">whatsapp.school.balance.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_failed': 1}</field>
    </record>
</odoo>
