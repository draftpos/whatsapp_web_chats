<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_school_balance_log_tree" model="ir.ui.view">
        <field name="name">whatsapp.school.balance.log.tree</field>
        <field name="model">whatsapp.school.balance.log</field>
        <field name="arch" type="xml">
            <tree string="School Balance Logs" decoration-danger="status == 'failed'" decoration-success="status == 'sent'">
                <field name="create_date" string="Date"/>
                <field name="whatsapp_account_id"/>
                <field name="student_name"/>
                <field name="parent_name"/>
                <field name="parent_number"/>
                <field name="balance_amount" widget="monetary"/>
                <field name="trigger_type"/>
                <field name="status" widget="badge" decoration-danger="status == 'failed'" decoration-success="status == 'sent'"/>
            </tree>
        </field>
    </record>

    <record id="view_whatsapp_school_balance_log_form" model="ir.ui.view">
        <field name="name">whatsapp.school.balance.log.form</field>
        <field name="model">whatsapp.school.balance.log</field>
        <field name="arch" type="xml">
            <form string="School Balance Log">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="whatsapp_account_id"/>
                            <field name="student_name"/>
                            <field name="parent_name"/>
                            <field name="parent_number"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="balance_amount" widget="monetary"/>
                            <field name="trigger_type"/>
                            <field name="move_id_ref"/>
                        </group>
                    </group>
                    <group string="Error Details" invisible="status != 'failed'">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_whatsapp_school_balance_log_search" model="ir.ui.view">
        <field name="name">whatsapp.school.balance.log.search</field>
        <field name="model">whatsapp.school.balance.log</field>
        <field name="arch" type="xml">
            <search string="Search Logs">
                <field name="student_name"/>
                <field name="parent_name"/>
                <field name="parent_number"/>
                <field name="whatsapp_account_id"/>
                <filter string="Sent Successfully" name="sent" domain="[('status', '=', 'sent')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_school_balance_log" model="ir.actions.act_window">
        <field name="name">School Balance Logs</field>
        <field name="res_model">whatsapp.school.balance.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_failed': 1}</field>
    </record>
</odoo>
