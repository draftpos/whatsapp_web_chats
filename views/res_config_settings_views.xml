<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsapp.web.chats</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="WhatsApp Chats" string="WhatsApp Chats" data-key="whatsapp_web_chats" groups="base.group_system">
                    <h2>WhatsApp Web Chats Settings</h2>
                    <div class="row mt16 o_settings_container" name="whatsapp_web_chats_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="wa_show_labels_setting">
                            <div class="o_setting_left_pane">
                                <field name="wa_show_labels"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="wa_show_labels"/>
                                <div class="text-muted">
                                    Show WhatsApp Chat Labels (Tags) on the web chat interface
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    
    <record id="action_whatsapp_web_chats_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module' : 'whatsapp_web_chats', 'bin_size': False}</field>
    </record>
</odoo>
