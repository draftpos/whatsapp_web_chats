<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wa_sharing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wa.sharing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="whatsapp_web_chats.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='whatsapp_web_chats_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="wa_contact_sharing_setting">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="wa_contact_sharing_mode"/>
                        <div class="text-muted">
                            Configure how WhatsApp contacts are shared within this tenant.
                        </div>
                        <div class="mt8">
                            <field name="wa_contact_sharing_mode" class="o_light_label" widget="radio"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="whatsapp_account_view_form_wa_sharing" model="ir.ui.view">
        <field name="name">whatsapp.account.view.form.wa.sharing</field>
        <field name="model">whatsapp.account</field>
        <field name="inherit_id" ref="whatsapp.whatsapp_account_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Contact Sharing">
                        <group>
                            <field name="wa_contact_sharing_mode" invisible="1"/>
                            <field name="shared_contact_account_ids" widget="many2many_tags" 
                                   invisible="wa_contact_sharing_mode != 'specific'"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    
    <record id="view_partner_form_wa_sharing" model="ir.ui.view">
        <field name="name">res.partner.view.form.wa.sharing</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="wa_account_id" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>
