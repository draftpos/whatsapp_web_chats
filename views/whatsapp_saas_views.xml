<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View for whatsapp_saas_tenant -->
    <record id="view_whatsapp_saas_tenant_tree" model="ir.ui.view">
        <field name="name">whatsapp.saas.tenant.tree</field>
        <field name="model">whatsapp.saas.tenant</field>
        <field name="arch" type="xml">
            <tree string="SaaS Tenants" editable="bottom">
                <field name="account_id" />
                <field name="tenant_id" readonly="1" />
                <field name="tenant_name" readonly="1" />
                <field name="tenant_phone" />
                <field name="scheduled_time" widget="float_time" />
                <field name="last_sales_sent_date" readonly="1" />
                <field name="welcome_message_sent" readonly="1" />
            </tree>
        </field>
    </record>

    <!-- Menu Action -->
    <record id="action_whatsapp_saas_tenant" model="ir.actions.act_window">
        <field name="name">SaaS Tenants Schedules</field>
        <field name="res_model">whatsapp.saas.tenant</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Extending whatsapp account form view to add SaaS integration tab -->
    <record id="whatsapp_account_view_form_inherit_saas" model="ir.ui.view">
        <field name="name">whatsapp.account.form.inherit.saas</field>
        <field name="model">whatsapp.account</field>
        <field name="inherit_id" ref="whatsapp.whatsapp_account_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="SaaS Integration" name="saas_integration">
                    <group>
                        <group string="SaaS Settings">
                            <field name="saas_integration_active" widget="boolean_toggle"/>
                            <field name="saas_app_url" attrs="{'invisible': [('saas_integration_active', '=', False)]}"/>
                            <field name="saas_username" attrs="{'invisible': [('saas_integration_active', '=', False)]}"/>
                            <field name="saas_password" password="True" attrs="{'invisible': [('saas_integration_active', '=', False)]}"/>
                        </group>
                        <group string="Templates" attrs="{'invisible': [('saas_integration_active', '=', False)]}">
                            <field name="saas_welcome_template_id"/>
                            <field name="saas_daily_sales_template_id"/>
                        </group>
                    </group>
                    <button name="%(action_whatsapp_saas_tenant)d" string="Manage Tenant Schedules" type="action" class="oe_highlight" attrs="{'invisible': [('saas_integration_active', '=', False)]}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
