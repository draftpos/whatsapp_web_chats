<?xml version="1.0" encoding="utf-8"?>
<!--
    Enterprise-only views and menus for dev_whatsapp_chatbot_ent integration.
    This file is only loaded when dev_whatsapp_chatbot_ent is installed
    (declared in __manifest__.py under depends_optional / loaded via hooks).
-->
<odoo>

    <!-- Move Chatbot parent menu under WhatsApp Configuration -->
    <menuitem id="dev_whatsapp_chatbot_ent.menu_wa_chatbot_parent"
              name="Chatbot"
              parent="whatsapp.whatsapp_configuration_menu"
              sequence="30"/>

    <!-- Extend chatbot flow action to include mobile kanban view -->
    <record id="dev_whatsapp_chatbot_ent.action_wa_chatbot_flow" model="ir.actions.act_window">
        <field name="name">Chatbot Flow</field>
        <field name="res_model">wa.chatbot.flow</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- Extend chatbot session action to include mobile kanban view -->
    <record id="dev_whatsapp_chatbot_ent.action_wa_chatbot_session" model="ir.actions.act_window">
        <field name="name">Chatbot Sessions</field>
        <field name="res_model">wa.chatbot.session</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- Extend chatbot keyword action to include mobile kanban view -->
    <record id="dev_whatsapp_chatbot_ent.action_wa_chatbot_keyword" model="ir.actions.act_window">
        <field name="name">Chatbot Keywords</field>
        <field name="res_model">wa.chatbot.keyword</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

</odoo>
