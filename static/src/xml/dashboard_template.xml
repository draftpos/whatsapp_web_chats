<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="whatsapp_web_chats.DashboardAction" owl="1">
        <div class="wa-dashboard-container" style="background-color: #f0f2f5; height: 100%; display: flex; flex-direction: column; overflow-y: auto;">
            <!-- Header with Filters -->
            <div class="wa-dashboard-header">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <i class="fa fa-pie-chart" style="font-size: 24px; color: #00a884;"></i>
                    <h2 style="margin: 0; color: #111b21; font-size: 20px; font-weight: 600;">WhatsApp Analytics</h2>
                </div>
                
                <div class="wa-dashboard-filters">
                    <div class="filter-group">
                        <label>Account:</label>
                        <select t-model="state.filters.accountId" t-on-change="fetchDashboardStats">
                            <option value="">All Accounts</option>
                            <t t-foreach="state.accounts" t-as="acc" t-key="acc.id">
                                <option t-att-value="acc.id"><t t-esc="acc.name"/></option>
                            </t>
                        </select>
                    </div>
                    
                    <div class="filter-group">
                        <label>From:</label>
                        <input type="date" t-model="state.filters.dateFrom" t-on-change="fetchDashboardStats"/>
                    </div>
                    
                    <div class="filter-group">
                        <label>To:</label>
                        <input type="date" t-model="state.filters.dateTo" t-on-change="fetchDashboardStats"/>
                    </div>
                    
                    <button t-on-click="resetFilters" style="padding: 8px 16px; background-color: #00a884; color: white; border: none; border-radius: 8px; font-weight: 500; cursor: pointer; transition: background 0.2s;">
                        <i class="fa fa-refresh" style="margin-right: 5px;"></i> Reset (Today)
                    </button>
                </div>
            </div>

            <!-- Loading Indicator -->
            <t t-if="state.isLoading">
                <div style="flex: 1; display: flex; justify-content: center; align-items: center;">
                    <i class="fa fa-spinner fa-spin" style="font-size: 40px; color: #00a884;"></i>
                </div>
            </t>
            
            <!-- Dashboard Content -->
            <t t-else="">
                <div class="wa-dashboard-content">
                    
                    <!-- Card 0: Active Chats -->
                    <div class="wa-stat-card" style="border-left: 5px solid #00a884;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: #54656f; font-size: 15px; font-weight: 600;">Active Chats</span>
                            <div style="background: #e6f6f2; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-comments" style="color: #00a884; font-size: 18px;"></i>
                            </div>
                        </div>
                        <span style="color: #111b21; font-size: 32px; font-weight: 700;"><t t-esc="state.stats.total_chats_active"/></span>
                        <span style="color: #667781; font-size: 13px;">Total active conversations in period</span>
                    </div>

                    <!-- Card 0.5: Chats Replied vs Not Replied -->
                    <div class="wa-stat-card" style="border-left: 5px solid #ff9800; grid-column: span 2;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                            <span style="color: #54656f; font-size: 15px; font-weight: 600;">Chat Engagement</span>
                            <div style="background: #fff3e0; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-exchange" style="color: #ff9800; font-size: 18px;"></i>
                            </div>
                        </div>
                        <div style="display: flex; gap: 40px; margin-top: 10px;">
                            <div>
                                <span style="display: block; color: #111b21; font-size: 28px; font-weight: 700;"><t t-esc="state.stats.replied_chats_count"/></span>
                                <span style="color: #667781; font-size: 14px;"><i class="fa fa-check-circle" style="color: #25D366;"></i> Replied</span>
                            </div>
                            <div>
                                <span style="display: block; color: #111b21; font-size: 28px; font-weight: 700;"><t t-esc="state.stats.not_replied_chats_count"/></span>
                                <span style="color: #667781; font-size: 14px;"><i class="fa fa-clock-o" style="color: #ea4335;"></i> Not Replied</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Card 1: New Inbound Messages -->
                    <div class="wa-stat-card" style="border-left: 5px solid #25D366;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: #54656f; font-size: 15px; font-weight: 600;">Active Inbound Chats</span>
                            <div style="background: #e7f8ef; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-envelope-open" style="color: #25D366; font-size: 18px;"></i>
                            </div>
                        </div>
                        <span style="color: #111b21; font-size: 32px; font-weight: 700;"><t t-esc="state.stats.new_inbound"/></span>
                        <span style="color: #667781; font-size: 13px;">Customer replies in this period</span>
                    </div>

                    <!-- Card 2: Delivered but Not Read (Unreplied) -->
                    <div class="wa-stat-card" style="border-left: 5px solid #fbbc04;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: #54656f; font-size: 15px; font-weight: 600;">Delivered (Not Read)</span>
                            <div style="background: #fef7e0; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-clock-o" style="color: #fbbc04; font-size: 20px;"></i>
                            </div>
                        </div>
                        <span style="color: #111b21; font-size: 32px; font-weight: 700;"><t t-esc="state.stats.unreplied_count"/></span>
                        <span style="color: #667781; font-size: 13px;">Sent messages awaiting to be read</span>
                    </div>

                    <!-- Card 3: Total Sent Messages -->
                    <div class="wa-stat-card" style="border-left: 5px solid #4285f4;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: #54656f; font-size: 15px; font-weight: 600;">Active Outbound Chats</span>
                            <div style="background: #e8f0fe; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-paper-plane" style="color: #4285f4; font-size: 18px;"></i>
                            </div>
                        </div>
                        <span style="color: #111b21; font-size: 32px; font-weight: 700;"><t t-esc="state.stats.total_sent"/></span>
                        <span style="color: #667781; font-size: 13px;">All outbound messages in period</span>
                    </div>

                    <!-- Card 4: Total Favorites -->
                    <div class="wa-stat-card" style="border-left: 5px solid #ff4b4b;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: #54656f; font-size: 15px; font-weight: 600;">Favorited Chats</span>
                            <div style="background: #ffeeee; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-heart" style="color: #ff4b4b; font-size: 18px;"></i>
                            </div>
                        </div>
                        <span style="color: #111b21; font-size: 32px; font-weight: 700;"><t t-esc="state.stats.total_favorites"/></span>
                        <span style="color: #667781; font-size: 13px;">Conversations marked as favorite</span>
                    </div>

                    <!-- Card 5: Media Sent -->
                    <div class="wa-stat-card" style="border-left: 5px solid #ff9800; grid-column: span 2;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                            <span style="color: #54656f; font-size: 15px; font-weight: 600;">Media Sent</span>
                            <div style="background: #fff3e0; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-upload" style="color: #ff9800; font-size: 18px;"></i>
                            </div>
                        </div>
                        <div style="display: flex; gap: 30px; margin-top: 10px;">
                            <div>
                                <span style="display: block; color: #111b21; font-size: 24px; font-weight: 700;"><t t-esc="state.stats.outbound_media.images"/></span>
                                <span style="color: #667781; font-size: 13px;"><i class="fa fa-image"></i> Images</span>
                            </div>
                            <div>
                                <span style="display: block; color: #111b21; font-size: 24px; font-weight: 700;"><t t-esc="state.stats.outbound_media.videos"/></span>
                                <span style="color: #667781; font-size: 13px;"><i class="fa fa-video-camera"></i> Videos</span>
                            </div>
                            <div>
                                <span style="display: block; color: #111b21; font-size: 24px; font-weight: 700;"><t t-esc="state.stats.outbound_media.documents"/></span>
                                <span style="color: #667781; font-size: 13px;"><i class="fa fa-file-text"></i> Documents</span>
                            </div>
                        </div>
                    </div>

                    <!-- Card 6: Media Received -->
                    <div class="wa-stat-card" style="border-left: 5px solid #00bcd4; grid-column: span 2;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                            <span style="color: #54656f; font-size: 15px; font-weight: 600;">Media Received</span>
                            <div style="background: #e0f7fa; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-download" style="color: #00bcd4; font-size: 18px;"></i>
                            </div>
                        </div>
                        <div style="display: flex; gap: 30px; margin-top: 10px;">
                            <div>
                                <span style="display: block; color: #111b21; font-size: 24px; font-weight: 700;"><t t-esc="state.stats.inbound_media.images"/></span>
                                <span style="color: #667781; font-size: 13px;"><i class="fa fa-image"></i> Images</span>
                            </div>
                            <div>
                                <span style="display: block; color: #111b21; font-size: 24px; font-weight: 700;"><t t-esc="state.stats.inbound_media.videos"/></span>
                                <span style="color: #667781; font-size: 13px;"><i class="fa fa-video-camera"></i> Videos</span>
                            </div>
                            <div>
                                <span style="display: block; color: #111b21; font-size: 24px; font-weight: 700;"><t t-esc="state.stats.inbound_media.documents"/></span>
                                <span style="color: #667781; font-size: 13px;"><i class="fa fa-file-text"></i> Documents</span>
                            </div>
                        </div>
                    </div>

                    <!-- Card 7: Total Contacts -->
                    <div class="wa-stat-card" style="border-left: 5px solid #8e24aa;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="color: #54656f; font-size: 15px; font-weight: 600;">Total Contacts</span>
                            <div style="background: #f4e8f6; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-users" style="color: #8e24aa; font-size: 18px;"></i>
                            </div>
                        </div>
                        <span style="color: #111b21; font-size: 32px; font-weight: 700;"><t t-esc="state.stats.total_contacts"/></span>
                        <span style="color: #667781; font-size: 13px;">Partners in your chat list</span>
                    </div>

                </div>
                
                <!-- Charts Section -->
                <div class="wa-dashboard-charts">
                    <!-- Line Chart: Messages Over Time -->
                    <div class="wa-chart-card">
                        <h4 style="color: #54656f; font-size: 16px; font-weight: 600; margin-top: 0; margin-bottom: 15px;">Messages Over Time</h4>
                        <canvas t-ref="lineChartCanvas"></canvas>
                    </div>

                    <!-- Doughnut Chart: Outbound Status -->
                    <div class="wa-chart-card">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                            <h4 style="color: #54656f; font-size: 16px; font-weight: 600; margin: 0;">Outbound Status</h4>
                            <button t-on-click="viewErrorLogs" style="background: none; border: none; color: #ea4335; font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: underline;">View Logs</button>
                        </div>
                        <canvas t-ref="doughnutChartCanvas"></canvas>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
